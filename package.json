{
  "name": "krunked-lumia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Krunked Lumia — standalone TypeScript + WebGL2 + Web Audio synesthetic diamond falling-block puzzle game.",
  "scripts": {
    "extract": "tsx tools/extract-assets.ts",
    "oracle": "tsx tools/oracle-dump.ts",
    "dev": "vite --port 5173",
    "play": "vite --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:assets": "tsx scripts/verify/verify-assets.ts",
    "verify:sim": "tsx scripts/verify/verify-sim.ts",
    "verify": "npm run typecheck && npm run test && npm run verify:assets && npm run verify:sim",
    "build": "vite build",
    "export:dna": "tsx export-dna.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
